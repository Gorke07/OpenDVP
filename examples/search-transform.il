; X1 prepares tables. X0 runs search, toggles, ramps, conversion and word SORT.
; With X0 OFF, X2 runs a separate double-word SORT (one global sort owner).
LD X1
MOV K88 D0
MOV K100 D1
MOV K110 D2
MOV K150 D3
MOV K100 D4
MOV K300 D5
MOV K100 D6
MOV K5 D7
MOV K100 D8
MOV K500 D9
MOV K10 D40
MOV K20 D41
SET M1026
MOV HAA12 D60
MOV HBB34 D61
MOV HCC56 D62
MOV H55EE D70
MOV H66DD D71
MOV K1 D100
MOV K2 D101
MOV K3 D102
MOV K4 D103
MOV K5 D104
MOV K75 D105
MOV K65 D106
MOV K98 D107
MOV K60 D108
MOV K79 D109
DMOV K88 D200
DMOV K100 D202
DMOV K110 D204
DMOV K100 D206
DMOV K100000 D240
DMOV K-100000 D242
DMOV K2147483647 D260
DMOV K-1 D262
DMOV K-2147483648 D264
DMOV K17 D266
LD X0
SERP D0 K100 D20 K10
DSERP D200 K100 D220 K4
ALT Y0
ALTP Y1
RAMP D40 D41 D42 K3
DRAMP D240 D242 D244 K3
DTMP D60 D70 K0 K3
SORT D100 K5 K2 D120 K2
LD X2
ANI X0
DSORT D260 K1 K1 D280 K4
END
